{
  "version": 2,
  "buildCommand": "composer install --no-dev --optimize-autoloader",
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.7.1",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/storage/(.+)",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/(css|js|images|fonts)/(.+)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(ico|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|otf|eot|css|js|map))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync"
  }
}